                        "name": "UserCreateCallback",
                        "funcName": "UserCreateCallback",
                        "description": "Callback invoked after a user is successfully created. Identifier of the plugin that initiated the call. Player ID of the created user. User immunity value passed to CreateUser (may be -1 if highest group priority was requested). Indicates whether the user's data was loaded without user presence on server. Array of groups inherited by the user. Callback invoked after a user is successfully created. Identifier of the plugin that initiated the call. Player ID of the created user. User immunity value passed to CreateUser (may be -1 if highest group priority was requested). Indicates whether the user's data was loaded without user presence on server. Array of groups inherited by the user.",
                        "paramTypes": [
                            {
                                "name": "pluginID",
                                "type": "int64",
                                "ref": false
                            },
                            {
