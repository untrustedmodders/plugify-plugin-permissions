        {
            "name": "OnUserRequest_Register",
            "funcName": "OnUserRequest_Register",
            "paramTypes": [
                {
                    "name": "callback",
                    "type": "function",
                    "ref": false,
                    "prototype": {
                        "name": "UserRequestCallback",
                        "funcName": "UserRequestCallback",
                        "description": "Called when a user data load is requested. This callback is triggered by the core when it requires user data to be loaded from an external storage (e.g. database). Extensions can subscribe to this event to perform the actual loading process and initialize the user in memory. This event does NOT guarantee that the user object already exists in memory. Identifier of the plugin that initiated the call. PlayerID of the user whose data should be loaded. The user's current username. Intended for synchronizing the username with external storage (e.g. updating an existing record or setting it during initial user creation). Insdicates whether the user's data was loaded without user presence on server. Called when a user data load is requested. This callback is triggered by the core when it requires user data to be loaded from an external storage (e.g. database). Extensions can subscribe to this event to perform the actual loading process and initialize the user in memory. This event does NOT guarantee that the user object already exists in memory. Identifier of the plugin that initiated the call. PlayerID of the user whose data should be loaded. The user's current username. Intended for synchronizing the username with external storage (e.g. updating an existing record or setting it during initial user creation). Insdicates whether the user's data was loaded without user presence on server.",
                        "paramTypes": [
